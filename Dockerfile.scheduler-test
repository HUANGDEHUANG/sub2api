# syntax=docker/dockerfile:1.7

ARG GOLANG_IMAGE=golang:1.27.0-alpine
ARG ALPINE_IMAGE=alpine:3.21
ARG POSTGRES_IMAGE=postgres:18-alpine
ARG GOPROXY=https://goproxy.cn,direct
ARG GOSUMDB=sum.golang.google.cn

FROM ${GOLANG_IMAGE} AS backend-builder
ARG VERSION=0.2.2
ARG COMMIT=buaga-custom-v0.2.2
ARG DATE
ARG GOPROXY
ARG GOSUMDB
ARG TARGETOS
ARG TARGETARCH

ENV GOPROXY=${GOPROXY}
ENV GOSUMDB=${GOSUMDB}

RUN apk add --no-cache git ca-certificates tzdata
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,id=sub2api-v022-gomod,target=/go/pkg/mod go mod download
COPY backend/ ./
# Fail closed unless the generated frontend contains every approved BUAGA feature.
RUN cd ./internal/web/dist \
    && test -f index.html \
    && grep -Fq 'BuaGa' index.html \
    && set -- assets/HomeView-*.js && test "$#" -eq 1 && test -f "$1" \
    && set -- assets/LoginView-*.js && test "$#" -eq 1 && test -f "$1" && grep -Fq 'BuaGa' "$1" && grep -Fq 'login_captcha_enabled' "$1" \
    && set -- assets/AppLayout*.js && test "$#" -eq 1 && test -f "$1" && grep -Fq 'long_notice_content' "$1" \
    && set -- assets/AnnouncementsView-*.js && test "$#" -eq 1 && test -f "$1" && grep -Fq 'long_notice_content' "$1" \
    && set -- assets/SettingsView-*.js && test "$#" -eq 1 && test -f "$1" && grep -Fq 'long_notice_content' "$1" \
    && set -- assets/ChannelMonitorView-*.js && test "$#" -eq 1 && test -f "$1" && grep -Fq 'monitor-sort-handle' "$1" \
    && grep -Fq '/admin/channel-monitors/sort-order' assets/index-*.js
RUN --mount=type=cache,id=sub2api-v022-gomod,target=/go/pkg/mod \
    --mount=type=cache,id=sub2api-v022-gobuild,target=/root/.cache/go-build \
    DATE_VALUE="${DATE:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}" && \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build \
    -tags embed \
    -ldflags="-s -w -X main.Version=${VERSION} -X main.Commit=${COMMIT} -X main.Date=${DATE_VALUE} -X main.BuildType=release" \
    -trimpath \
    -o /app/sub2api \
    ./cmd/server

FROM ${POSTGRES_IMAGE} AS pg-client

FROM ${ALPINE_IMAGE}
LABEL maintainer="Wei-Shaw <github.com/Wei-Shaw>"
LABEL description="Sub2API - BUAGA customized AI API Gateway"
LABEL org.opencontainers.image.source="https://github.com/Wei-Shaw/sub2api"

RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    su-exec \
    libpq \
    zstd-libs \
    lz4-libs \
    krb5-libs \
    libldap \
    libedit \
    && rm -rf /var/cache/apk/*

COPY --from=pg-client /usr/local/bin/pg_dump /usr/local/bin/pg_dump
COPY --from=pg-client /usr/local/bin/psql /usr/local/bin/psql
COPY --from=pg-client /usr/local/lib/libpq.so.5* /usr/local/lib/

RUN addgroup -g 1000 sub2api && adduser -u 1000 -G sub2api -s /bin/sh -D sub2api
WORKDIR /app
COPY --from=backend-builder --chown=sub2api:sub2api /app/sub2api /app/sub2api
COPY --from=backend-builder --chown=sub2api:sub2api /app/backend/resources /app/resources
# Keep an inspectable copy of the approved UI inside the candidate image.
# The switch validator reads this without starting the application.
COPY --from=backend-builder /app/backend/internal/web/dist/ /app/.buaga-release/
RUN mkdir -p /app/data && chown sub2api:sub2api /app/data
COPY deploy/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -q -T 5 -O /dev/null http://localhost:${SERVER_PORT:-8080}/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["/app/sub2api"]

FROM backend-builder AS scheduler-tests
RUN --mount=type=cache,id=sub2api-v022-gomod,target=/go/pkg/mod \
    --mount=type=cache,id=sub2api-v022-gobuild,target=/root/.cache/go-build \
    GOMAXPROCS=4 go test -tags unit -p 2 -count=1 -timeout=10m ./internal/service ./internal/handler ./internal/config \
    -run 'Test.*(TransientRefinement|AccountTransient|AccountScheduler|WithScheduler|LoadAwareness|PreviousResponseID|TransientError|ModelTransient|Availability|PoolMode|AcquireResponsesAccountSlot|OpenAIAccountRuntime|SchedulingConfig|ProvideConcurrencyService|CleanupStaleProcess)'
RUN --mount=type=cache,id=sub2api-v022-gomod,target=/go/pkg/mod \
    --mount=type=cache,id=sub2api-v022-gobuild,target=/root/.cache/go-build \
    GOMAXPROCS=4 go test -tags unit -p 2 -count=20 -timeout=5m ./internal/service -run 'TestOpenAITransientRefinement' \
    && GOMAXPROCS=4 go test -tags unit -p 2 -count=1 -timeout=5m ./internal/handler/admin -run 'Test.*AvailableModels'
